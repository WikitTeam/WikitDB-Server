generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int      @id @default(autoincrement())
  username       String   @unique @db.VarChar(20)
  password       String
  email          String?  @unique
  balance        Decimal  @default(10000) @db.Decimal(12, 2)
  wikidotAccount String?
  isAdmin        Boolean  @default(false)
  isStaff        Boolean  @default(false) // 是否职员（可进入职员面板审核代发）
  staffSites     String?  @db.Text       // 职员负责的站点 PARAM 数组（JSON 字符串）
  status         String   @default("active") @db.VarChar(10)
  createdAt      DateTime @default(now())

  trades       Trade[]
  gachas       Gacha[]
  images       Image[]
  bountyClaims BountyClaim[]
  proxyPosts   ProxyPost[]

  @@map("users")
}

model BountyClaim {
  bountyId  String   @id @db.VarChar(100)
  userId    Int
  wiki      String   @db.VarChar(100)
  page      String
  reward    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("bounty_claims")
}

model Trade {
  id          Int      @id @default(autoincrement())
  userId      Int
  type        String   @db.VarChar(20)
  amount      Decimal  @db.Decimal(12, 2)
  target      String
  status      String   @default("OPEN") @db.VarChar(20)
  description String?  @db.Text
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("trades")
}

model Gacha {
  id        Int      @id @default(autoincrement())
  userId    Int
  poolId    String   @default("DEFAULT") @db.VarChar(50)
  result    String
  cost      Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("gachas")
}

model Image {
  id         Int      @id @default(autoincrement())
  uploaderId Int
  createdAt  DateTime @default(now())

  uploader User @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([uploaderId])
  @@map("images")
}

model Setting {
  key       String   @id
  value     String   @db.Text
  createdAt DateTime @default(now())

  @@map("settings")
}

model BotAccount {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(50)
  username    String    @db.VarChar(100)
  password    String    @db.Text
  createdBy   String    @db.VarChar(50)
  scanInterval Int? // 自动扫描间隔（分钟），null/0 = 不自动扫描
  scanSites   String?   @db.Text // JSON 数组，如 ["dfc","brcn"]
  deleteScore Int? // 删除线（评分阈值），null = 使用默认 -5
  countdownHours Int? // 计时器倒计时小时数，null = 使用默认 72
  sessionCookie String? @db.Text // 持久化的 Wikidot 登录会话（加密），避免频繁登录触发限流
  lastScanAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([createdBy])
  @@map("bot_accounts")
}

model TempReg {
  username   String   @id @db.VarChar(20)
  verifyCode String   @unique @db.VarChar(32)
  password   String
  wdid       String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([expiresAt])
  @@map("temp_registrations")
}

model VerificationCode {
  email     String   @id
  code      String   @db.VarChar(12)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("verification_codes")
}

model AccessLog {
  id        Int      @id @default(autoincrement())
  method    String   @db.VarChar(10)
  path      String
  status    Int?
  ip        String?
  userAgent String?  @db.Text
  username  String?
  duration  Int?
  type      String?  @db.VarChar(20)
  payload   String?  @db.Text
  headers   String?  @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("access_logs")
}

model ForumCategory {
  id           Int       @id @default(autoincrement())
  siteParam    String    @db.VarChar(50)
  categoryId   String    @db.VarChar(50)
  title        String
  description  String    @default("") @db.Text
  threadsCount Int       @default(0)
  postsCount   Int       @default(0)
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())

  @@unique([siteParam, categoryId])
  @@map("forum_categories")
}

model ForumThread {
  id           Int       @id @default(autoincrement())
  siteParam    String    @db.VarChar(50)
  threadId     String    @db.VarChar(50)
  categoryId   String    @db.VarChar(50)
  title        String
  createdBy    String
  postCount    Int       @default(0)
  isSticky     Boolean   @default(false)
  isLocked     Boolean   @default(false)
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())

  @@unique([siteParam, threadId])
  @@index([siteParam, categoryId])
  @@map("forum_threads")
}

model ForumPost {
  id          Int      @id @default(autoincrement())
  siteParam   String   @db.VarChar(50)
  postId      String   @db.VarChar(50)
  threadId    String   @db.VarChar(50)
  parentId    String?  @db.VarChar(50)
  title       String   @default("")
  contentHtml String   @db.Text
  author      String
  authorId    String?
  createdAt   DateTime @default(now())

  @@unique([siteParam, postId])
  @@index([siteParam, threadId])
  @@map("forum_posts")
}

model ProxyPost {
  id           Int      @id @default(autoincrement())
  userId       Int      // 提交人（本站用户）
  username     String   @db.VarChar(20)
  site         String   @db.VarChar(50) // 目标站点 PARAM
  siteName     String   @default("") @db.VarChar(100)
  page         String   @db.VarChar(200)
  title        String   @default("")
  source       String   @db.Text
  comments     String?  @db.Text
  status       String   @default("pending") @db.VarChar(20) // pending/approved/rejected/sent/failed
  reviewNote   String?  @db.Text
  reviewedBy   String?  @db.VarChar(20)
  reviewedAt   DateTime?
  botAccountId Int?
  botLabel     String?  @db.VarChar(100)
  sendResult   String?  @db.Text
  sentAt       DateTime?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([site])
  @@index([userId])
  @@map("proxy_posts")
}

model AuthorAttribution {
  id        Int      @id @default(autoincrement())
  siteParam String   @db.VarChar(50) // 站点 PARAM
  page      String   @db.VarChar(200) // 页面名（含类目前缀）
  username  String   @db.VarChar(100) // 作者用户名
  type      String   @default("作者") @db.VarChar(20) // 作者/重写/翻译/维护者
  date      String   @default("") @db.VarChar(10)    // YYYY-MM-DD（可空）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteParam, page, username, type, date])
  @@index([siteParam])
  @@index([username])
  @@index([page])
  @@map("author_attributions")
}
