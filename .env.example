# 定时任务密钥（至少 16 字符）。Vercel Cron 和 GitHub Actions 用它调用 /api/cron/*。
# 生产环境必须设置，否则调度接口一律 401。
CRON_SECRET=

# 可选：Upstash Redis。配上之后全局限速在所有无服务器实例之间共享。
# 不配则只在单个实例内计数。
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# 无服务器函数不要用「直连 + 大连接池」。
# Neon / Supabase 请用带 pgbouncer 的 pooler 连接串，并带上 connection_limit=1。
# 在 Vercel 上如果漏了 connection_limit，运行时会自动补上。
DATABASE_URL=postgresql://user:password@localhost:5432/wikitdb?connection_limit=1

JWT_SECRET=replace-with-at-least-32-random-bytes
SITE_ORIGIN=https://example.com
TRUST_PROXY=false

# 邮件发信配置（注册验证码）
# 163 邮箱示例：SMTP_HOST=smtp.163.com  SMTP_PORT=465  SMTP_USER=邮箱地址  SMTP_PASS=授权码(非登录密码)
# QQ 邮箱示例：SMTP_HOST=smtp.qq.com  SMTP_PORT=465  SMTP_USER=邮箱地址  SMTP_PASS=授权码
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# 可选：强制指定连接模式（不填则按端口推断，465=SSL，587/25=STARTTLS）
# SMTP_SECURE=true
# 可选：自定义发件人地址，默认使用 SMTP_USER
# SMTP_FROM=

WIKIDOT_BOT_USER=
WIKIDOT_BOT_PASS=

# 开发环境身份切换开关（/api/dev/login）
# 该接口能直接签发任意角色的 JWT，默认关闭。
# 本地调试时设为 1，并先执行 node scripts/dev-seed.js 造账号。
# 生产环境即使误设也不会生效（NODE_ENV=production 时无条件 404）。
ENABLE_DEV_LOGIN=

# dev-seed.js 写入的测试账号口令（可选，未设置时用内置默认值）
DEV_SEED_PASSWORD=
